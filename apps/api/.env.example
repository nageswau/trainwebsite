# Copy to .env and fill in. Every value below is optional unless noted -- an unset
# integration reports "not_configured" rather than failing, same discipline everywhere
# in this codebase (see app/core/config.py).

# --- Core (required for local dev) ---
SECRET_KEY=change-me
DATABASE_URL=postgresql+asyncpg://edusphere:edusphere@localhost:5432/edusphere
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

# --- School invite emails (real SMTP sending, Coordinator-issued Teacher/Principal/
# Parent invites and roster-driven parent invites) ---
# Fill these in with your own SMTP provider (Gmail app password, SendGrid SMTP relay,
# Mailtrap, etc.) to actually send the invite email. Left unset, invites are still
# created (and, in ENVIRONMENT=development, the accept link is returned directly in the
# API response as development_invite_token) but no email goes out.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Must be an address your SMTP provider will actually let you send FROM (its own
# verified account) -- providers reject/quarantine mail claiming a From they haven't
# verified. The Coordinator's own name still appears as the display name and Reply-To
# on every invite email, so replies go straight to them.
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# --- Email transport (ENH-032, DEC-SCOPE-225) ---
# smtp (default): send through SMTP_* above. zoho_api: send through the Zoho Mail REST API over HTTPS (port 443),
# for hosts that block outbound SMTP (DigitalOcean does). SMTP_FROM_EMAIL is the From address for both transports.
EMAIL_TRANSPORT=smtp
# Used only when EMAIL_TRANSPORT=zoho_api. A Server-based client from https://api-console.zoho.in with the scopes
# ZohoMail.messages.CREATE,ZohoMail.accounts.READ; separate from the Zoho Meeting client. All four empty = email "not configured".
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
# The mailbox's numeric account id (GET {ZOHO_MAIL_API_BASE}/api/accounts).
ZOHO_MAIL_ACCOUNT_ID=
# https://mail.zoho.com (default) or the India data centre https://mail.zoho.in. The OAuth host is ZOHO_ACCOUNTS_URL.
ZOHO_MAIL_API_BASE=https://mail.zoho.com

# --- Other optional integrations (unrelated to this addendum, listed for completeness) ---
CRM_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
SMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
