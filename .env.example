# Copy to .env for local development. Never commit .env (already gitignored).
# Placeholder values only -- no real secrets belong in this file.

APP_NAME=EduSphere
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace-with-a-random-value-before-any-non-local-use
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14
DATABASE_URL=postgresql+asyncpg://edusphere:edusphere@postgres:5432/edusphere
REDIS_URL=redis://redis:6379/0
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false
AUTO_CREATE_SCHEMA=true

# Object storage (DigitalOcean Spaces, S3-compatible -- ADR-004). Leave blank for local filesystem fallback.
AWS_REGION=eu-west-2
AWS_S3_BUCKET=
LOCAL_UPLOAD_DIR=/data/uploads

# Integrations -- all optional in development; leave blank until each provider is confirmed/configured.
# Zoho: CRM webhook (DEC-SCOPE-001) + Meeting (DEC-LIVE-001). Auth mechanism not yet confirmed (INTEGRATION_CONTRACTS.md §7).
CRM_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
SMS_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=
# --- Email transport (ENH-032, DEC-SCOPE-225) ---
# smtp (default): send through SMTP_HOST/SMTP_* (see apps/api/.env.example). zoho_api: send through the Zoho Mail REST API over HTTPS (port 443),
# for hosts that block outbound SMTP (DigitalOcean does). SMTP_FROM_EMAIL is the From address for both transports.
EMAIL_TRANSPORT=smtp
# Used only when EMAIL_TRANSPORT=zoho_api. A Server-based client from https://api-console.zoho.in with the scopes
# ZohoMail.messages.CREATE,ZohoMail.accounts.READ; separate from the Zoho Meeting client. All four empty = email "not configured".
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
# The mailbox's numeric account id (GET {ZOHO_MAIL_API_BASE}/api/accounts).
ZOHO_MAIL_ACCOUNT_ID=
# https://mail.zoho.com (default) or the India data centre https://mail.zoho.in. The OAuth host is ZOHO_ACCOUNTS_URL.
ZOHO_MAIL_API_BASE=https://mail.zoho.com
# Twilio WhatsApp + SMS (ENH-014, DEC-NOT-001 2026-09-30). All five empty = not configured: deliveries are recorded as `not_configured`.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM / TWILIO_SMS_FROM: E.164 numbers (e.g. +14155238886), without a "whatsapp:" prefix.
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
INBOUND_EMAIL_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
ZOHO_PRESENTER_ID=
# OAuth host, shared by Zoho Meeting and the Zoho Mail API (ENH-032). Default https://accounts.zoho.com; the India data centre
# must set https://accounts.zoho.in together with ZOHO_MAIL_API_BASE=https://mail.zoho.in.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_MEETING_BASE_URL=https://meeting.zoho.com

MAX_UPLOAD_BYTES=20971520
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# Payments -- Razorpay only (DEC-PAY-001, re-resolved 2026-09-03: Stripe removed).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

API_PORT=8000
WEB_PORT=3000
